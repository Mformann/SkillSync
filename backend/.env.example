# Local default. Production must use a persistent postgresql:// connection URL.
DATABASE_URL=sqlite:///./resume_analyzer.db
SUPABASE_URL=https://your-project.supabase.co
# Public publishable key (legacy anon keys also work). Never use a service-role key.
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_ANALYSIS_LIMIT=5
# Optional approved public employer feeds; comma-separated identifiers, not URLs.
JOB_FEED_GREENHOUSE_BOARDS=
JOB_FEED_LEVER_COMPANIES=
ENVIRONMENT=development
ENABLE_API_DOCS=true
MAX_REQUEST_BYTES=12582912
