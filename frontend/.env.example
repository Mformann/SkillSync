# Use the deployed HTTPS API origin in production (no path or trailing slash).
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public key only; never use sb_secret_* or a service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Legacy VITE_SUPABASE_ANON_KEY is also accepted when the publishable key is absent.
